#include <Server.h>

namespace MyServer {
AsyncWebServer server(80);

void init() {
  server.on("/setup", HTTP_POST, _setup);
  server.on("/clear", HTTP_POST, _clearCredentials);  // endpoint for clearing ssid / pwd
  server.on("/info", HTTP_ANY, _info);
  // server.on("/state", HTTP_ANY, _getState);
  server.on("/restart", HTTP_ANY, _restart);
  server.on(SETTINGS_FILE, HTTP_ANY, _FORBIDDEN);
  server.serveStatic("/", LittleFS, "/");
  server.onNotFound(_info);
  server.begin();
}

void _restart(AsyncWebServerRequest* request) {
  request->send(200,
                "text/plain"
                "Booting now");
  ESP.restart();
}

void _FORBIDDEN(AsyncWebServerRequest* request) {
  request->send(403, "text/plain", "Access Forbidden");
}

void _info(AsyncWebServerRequest* request) {
  request->send(200, "application/json", Settings::getInfoJson().c_str());
}

void _clearCredentials(AsyncWebServerRequest* request) {
  if (Settings::clear()) {
    request->send(200, "text/plain", "EEPROM cleared!");
    return;
  }

  request->send(500, "text/plain", "Error clearing EEEPROM");
}

void _setup(AsyncWebServerRequest* request) {
  // check post params exist
  String requiredArgs[] = {
      "pass",
      "ssid",
      "broker",
      "ap_ssid",
  };

  for (byte i = 0; i < 4; i++) {
    if (!request->hasArg(requiredArgs[i].c_str())) {
      request->send(400, "text/plain", String("Missing parameter [" + requiredArgs[i] + "]").c_str());
      return;
    }
  }

  request->arg("ssid").toCharArray(Settings::ssid, 32);
  request->arg("pass").toCharArray(Settings::pass, 32);
  request->arg("broker").toCharArray(Settings::broker, 32);
  request->arg("ap_ssid").toCharArray(Settings::ap_ssid, 32);

  if (Settings::store()) {
    request->send(200, "text/plain", "Settings stored, restarting");
    ESP.restart();
    return;
  }

  request->send(500, "text/plain", "Unable to store settings");
}
}  // namespace MyServer
